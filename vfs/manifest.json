{
  "format_version": 1,
  "mount": "data",
  "alignment": 4,
  "include": [
    "cubetxt?.dat",
    "demo.?",
    "estsc.shp",
    "levels?.dat",
    "music.mus",
    "palette.dat",
    "shapes*.dat",
    "tshp2.pcx",
    "tyrian.cdt",
    "tyrian.hdt",
    "tyrian.pic",
    "tyrian.shp",
    "tyrian?.lvl"
  ],
  "exclude": [],
