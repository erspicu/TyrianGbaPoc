    }
  ],
  "retained_sources": [
    {
      "pattern": "music.mus",
      "reason": "Runtime authority for all 41 stock songs, including script-selected Halloween Ramble"
    }
  ],
  "probes": [
    "tyrian1.lvl",
    "tyrian.hdt",
    "music.mus",
    "tyrian.shp",
    "tyrian.pic"
  ]
